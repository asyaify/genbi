# LLM
API_KEY=your_ai_tunnel_api_key

# SSAS / XMLA
CUBE_URL=http://your-ssas-endpoint
CUBE_USERNAME=your_username
CUBE_PASSWORD=your_password
CATALOG=your_catalog_name

# Метод аутентификации: basic, ntlm или auto (auto пробует NTLM, затем Basic)
AUTH_METHOD=auto

# Streamlit app auth
APP_PASSWORD=change_me

# Если в пароле есть символ '$', в файле .env для docker-compose используйте '$$'
# Пример: pa$$word
