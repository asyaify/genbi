              "        [Движения, кг.],",
              "        KEEPFILTERS('009 Документы движения'[Документ Тип]",
              "            IN {",
              "            \"Возврат товаров поставщику\",",
              "            \"Корректировка приобретения\",",
              "            \"Оприходование излишков товаров\",",
              "            \"Поступление от переработчика\",",
              "            \"Приобретение услуг и прочих активов\",",
              "            \"Приобретение товаров и услуг\"",
              "        })",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Поступления"
          },
          {
            "name": "Остатки Начальные, кг.",
            "expression": [
              "",
              "VAR clc =",
              "    CALCULATE (",
              "        [Движения, кг.],",
              "        FILTER (",
              "            ALL ( '000 Календарь' ),",
              "            '000 Календарь'[Дата] < MIN ( '000 Календарь'[Дата] )",
              "        ),",
              "        KEEPFILTERS ( NOT ( SIGN ( 'М001 Движения'[Вид движения] ) = -1 ) )",
              "    )",
              "VAR result =",
              "    IF ( [Показать данные с датой], clc )",
              "RETURN",
              "    result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Остатки\\Начальные"
          },
          {
            "name": "Остатки Конечные, кг.",
            "expression": [
              "",
              "VAR _msr =",
