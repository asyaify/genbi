          {
            "name": "Заказ клиента (в заказе поставщику), м.куб.",
            "expression": [
              "",
              "    VAR _result =",
              "        CALCULATE (",
              "            [Заказ клиента, м.куб.],",
              "            'М001 Движения'[Вариант обеспечения]",
              "                IN { \"Резервировать к дате\", \"К обеспечению\", \"Обеспечивать обособленно\" },",
              "            NOT ISBLANK ( 'М001 Движения'[ID Заказ Поставщику] ),",
              "            ISBLANK ( 'М001 Движения'[ID Реализация] ),",
              "            ISBLANK ( 'М001 Движения'[ID Приобретение] )",
              "        )",
              "    RETURN",
              "        _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ клиента\\М.куб."
          },
          {
            "name": "Отгрузить обособленно по заказу, руб.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ клиента, руб.],",
              "        'М001 Движения'[Вариант обеспечения] IN { \"Отгрузить обособленно\" }",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ клиента\\Руб."
          },
          {
            "name": "К обеспечению, руб.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ клиента, руб.],",
              "        'М001 Движения'[Вариант обеспечения] IN { \"К обеспечению\" }",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ клиента\\Руб."
          },
          {
            "name": "Заказ клиента (в заказе поставщику), руб.",
            "expression": [
              "",
              "    VAR _result =",
              "        CALCULATE (",
              "            [Заказ клиента, руб.],",
              "            'М001 Движения'[Вариант обеспечения]",
              "                IN { \"Резервировать к дате\", \"К обеспечению\", \"Обеспечивать обособленно\" },",
              "            NOT ISBLANK ( 'М001 Движения'[ID Заказ Поставщику] ),",
              "            ISBLANK ( 'М001 Движения'[ID Реализация] ),",
              "            ISBLANK ( 'М001 Движения'[ID Приобретение] )",
              "        )",
              "    RETURN",
              "        _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ клиента\\Руб."
          },
          {
            "name": "Заказ поставщику (ещё не поступило), ед.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ поставщику, ед.],",
              "        ISBLANK ( 'М001 Движения'[ID Приобретение] )",
              "        --,KEEPFILTERS('009 Документы движения'[Статус] = \"Подтвержден\")",
              "    )",
              "RETURN",
              "     _result "
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ поставщику\\Ед."
          },
          {
            "name": "Заказ поставщику (ещё не поступило), кг.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ поставщику, кг.],",
              "        ISBLANK ( 'М001 Движения'[ID Приобретение] )",
              "        --,KEEPFILTERS('009 Документы движения'[Статус] = \"Подтвержден\")",
              "    )",
              "RETURN",
              "     _result "
            ],
            "formatString": "#,0.00",
            "displayFolder": "Заказ поставщику\\Кг."
          },
          {
            "name": "Заказ поставщику (ещё не поступило), м.куб.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ поставщику, м.куб.],",
              "        ISBLANK ( 'М001 Движения'[ID Приобретение] )",
              "        --,KEEPFILTERS('009 Документы движения'[Статус] = \"Подтвержден\")",
              "    )",
              "RETURN",
              "     _result "
            ],
            "formatString": "#,0.00",
            "displayFolder": "Заказ поставщику\\М.куб."
          },
          {
            "name": "Заказ поставщику (ещё не поступило), руб.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ поставщику, руб.],",
              "        ISBLANK ( 'М001 Движения'[ID Приобретение] )",
              "        --,KEEPFILTERS('009 Документы движения'[Статус] = \"Подтвержден\")",
              "    )",
              "RETURN",
              "     _result "
            ],
            "formatString": "#,0.00",
            "displayFolder": "Заказ поставщику\\Руб."
          },
          {
            "name": "Кол-во документов",
            "expression": [
              "",
              "VAR N =",
              "    SUMX ( GROUPBY ( 'М001 Движения', '009 Документы движения'[ID Документ] ), 1 )",
              "RETURN",
              "    SWITCH (",
              "        TRUE,",
              "        ISFILTERED ( '0091 Документы заказы клиентов' )",
              "            || ISFILTERED ( '0092 Документы запросы снабженцам' )",
              "            || ISFILTERED ( '0093 Документы реализации' )",
              "            || ISFILTERED ( '0094 Документы заказы поставщикам' )",
              "            || ISFILTERED ( '0095 Документы поступления' ),",
              "            IF (",
              "                NOT ISBLANK ( [Движения ед] ),",
              "                \"Использовать поля из таблицы '009 Документы движения'\"",
              "            ),",
              "        N",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "Базовые меры"
          },
          {
            "name": "Кол-во заказов клиентов",
            "expression": [
              "",
              "VAR N =",
              "    CALCULATE (",
              "        [Кол-во документов],",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Заказ клиента\" )",
              "    )",
              "RETURN",
              "    N"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ клиента"
          },
          {
            "name": "Кол-во запросов снабженцам",
            "expression": [
              "",
              "VAR N =",
              "    CALCULATE (",
              "        [Кол-во документов],",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Запрос снабженцу\" )",
              "    )",
              "RETURN",
              "    N"
            ],
            "formatString": "#,0",
            "displayFolder": "Запрос снабженцу"
          },
          {
            "name": "Наценка, %",
            "expression": [
              "",
              "VAR Cost = [Себестоимость]",
              "VAR Rev = [Валовая прибыль]",
              "RETURN",
              "    IF ( Cost = 0 && Rev <> 0, 0, DIVIDE ( Rev, Cost ) )"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Валовая прибыль"
          },
          {
            "name": "Наценка (Прошлый год), %",
            "expression": [
              "",
              "VAR Cost = [Себестоимость (Прошлый год)]",
              "VAR Rev = [Валовая прибыль (Прошлый год)]",
              "RETURN",
              "    IF ( Cost = 0 && Rev <> 0, 0, DIVIDE ( Rev, Cost ) )"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Валовая прибыль"
          },
          {
            "name": "Наценка (Отклонение к ПГ), %",
            "expression": [
              "",
              "VAR _value = [Наценка, %]",
              "VAR _value_py = [Наценка (Прошлый год), %]",
              "VAR _result = _value - _value_py",
              "RETURN",
              "    _result"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Валовая прибыль"
          },
          {
            "name": "Продажи ед. (Прошлый год)",
            "expression": [
              "",
              "VAR _mn_dt =",
              "            CALCULATE ( MIN ( '000 Календарь'[Дата] ) )",
              "        VAR _mx_dt =",
              "            CALCULATE ( MAX ( '000 Календарь'[Дата] ), '000 Календарь'[Дата с Движениями] )",
              "        VAR _pr_year_mx_dt =",
              "            DATE ( YEAR ( _mx_dt ) - 1, MONTH ( _mx_dt ), DAY ( _mx_dt ) )",
              "        VAR _pr_year_min_dt =",
              "            DATE ( YEAR ( _mn_dt ) - 1, MONTH ( _mn_dt ), DAY ( _mn_dt ) )",
              "        VAR _end_of_mnth =",
              "            CALCULATE (",
              "                ENDOFMONTH ( '000 Календарь'[Дата] ),",
              "                '000 Календарь'[Дата с Движениями]",
              "            )",
              "        VAR _pr_year_mx_dt_full_mnth =",
              "            DATE ( YEAR ( _mx_dt ) - 1, MONTH ( _mx_dt ), DAY ( _end_of_mnth ) )",
              "        VAR _is_day_fltrd =",
              "            OR (",
              "                ISFILTERED ( '000 Календарь'[Дата] ),",
              "                ISFILTERED ( '000 Календарь'[Неделя] )",
              "            )",
              "        VAR _result =",
              "            CALCULATE (",
              "                [Продажи ед.],",
              "                '000 Календарь'[Дата] >= _pr_year_min_dt,",
              "                IF (",
              "                    NOT _is_day_fltrd,",
              "                    '000 Календарь'[Дата] <= _pr_year_mx_dt_full_mnth,",
              "                    '000 Календарь'[Дата] <= _pr_year_mx_dt",
              "                )",
              "            )",
              "        RETURN",
              "            _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Продажи\\Продажи ед."
          },
          {
            "name": "Продажи ед. (Отклонение к ПГ)",
            "expression": [
              "",
              "VAR _value = [Продажи ед.]",
              "VAR _value_py = [Продажи ед. (Прошлый год)]",
              "VAR _result = _value - _value_py",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Продажи\\Продажи ед."
          },
          {
            "name": "Продажи ед. (Отклонение к ПГ, %)",
            "expression": [
              "",
              "VAR _value = [Продажи ед.]",
              "VAR _value_py = [Продажи ед. (Прошлый год)]",
              "VAR _result =",
              "    IF (",
              "        NOT ISBLANK ( _value ) && ISBLANK ( _value_py ),",
              "        1,",
              "        IF (",
              "            NOT ISBLANK ( _value ) || NOT ISBLANK ( _value_py ),",
              "            DIVIDE ( _value, _value_py ) - 1",
              "        )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.0%;-#,0.0%;#,0.0%",
            "displayFolder": "Продажи\\Продажи ед."
          },
          {
            "name": "Продажи м.куб. (Прошлый год)",
            "expression": [
              "",
              "--[Продажи м.куб.]",
              "VAR _mn_dt =",
              "            CALCULATE ( MIN ( '000 Календарь'[Дата] ) )",
              "        VAR _mx_dt =",
              "            CALCULATE ( MAX ( '000 Календарь'[Дата] ), '000 Календарь'[Дата с Движениями] )",
              "        VAR _pr_year_mx_dt =",
              "            DATE ( YEAR ( _mx_dt ) - 1, MONTH ( _mx_dt ), DAY ( _mx_dt ) )",
              "        VAR _pr_year_min_dt =",
              "            DATE ( YEAR ( _mn_dt ) - 1, MONTH ( _mn_dt ), DAY ( _mn_dt ) )",
              "        VAR _end_of_mnth =",
              "            CALCULATE (",
              "                ENDOFMONTH ( '000 Календарь'[Дата] ),",
              "                '000 Календарь'[Дата с Движениями]",
              "            )",
              "        VAR _pr_year_mx_dt_full_mnth =",
              "            DATE ( YEAR ( _mx_dt ) - 1, MONTH ( _mx_dt ), DAY ( _end_of_mnth ) )",
              "        VAR _is_day_fltrd =",
              "            OR (",
              "                ISFILTERED ( '000 Календарь'[Дата] ),",
              "                ISFILTERED ( '000 Календарь'[Неделя] )",
              "            )",
              "        VAR _result =",
              "            CALCULATE (",
              "                [Продажи м.куб.],",
              "                '000 Календарь'[Дата] >= _pr_year_min_dt,",
              "                IF (",
              "                    NOT _is_day_fltrd,",
              "                    '000 Календарь'[Дата] <= _pr_year_mx_dt_full_mnth,",
              "                    '000 Календарь'[Дата] <= _pr_year_mx_dt",
              "                )",
              "            )",
              "        RETURN",
              "            _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Продажи\\Продажи м.куб."
          },
          {
            "name": "Продажи м.куб. (Отклонение к ПГ)",
            "expression": [
              "",
              "VAR _value = [Продажи м.куб.]",
              "VAR _value_py = [Продажи м.куб. (Прошлый год)]",
              "VAR _result = _value - _value_py",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Продажи\\Продажи м.куб."
          },
          {
            "name": "Продажи м.куб. (Отклонение к ПГ, %)",
            "expression": [
              "",
              "VAR _value = [Продажи м.куб.]",
              "VAR _value_py = [Продажи м.куб. (Прошлый год)]",
              "VAR _result =",
              "    IF (",
              "        NOT ISBLANK ( _value ) && ISBLANK ( _value_py ),",
              "        1,",
              "        IF (",
              "            NOT ISBLANK ( _value ) || NOT ISBLANK ( _value_py ),",
              "            DIVIDE ( _value, _value_py ) - 1",
              "        )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.0%;-#,0.0%;#,0.0%",
            "displayFolder": "Продажи\\Продажи м.куб."
          },
          {
            "name": "Продажи м.куб. (% от общего объема)",
            "expression": [
              "",
              "DIVIDE (",
              "    [Продажи м.куб.],",
              "    CALCULATE ( [Продажи м.куб.], ALLSELECTED ( '005 Номенклатура' ) )",
              ")",
              ""
            ],
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Продажи\\Продажи м.куб."
          },
          {
            "name": "Продажи кг. (Прошлый год)",
            "expression": [
              "",
              "--[Продажи кг.]",
              "VAR _mn_dt =",
              "            CALCULATE ( MIN ( '000 Календарь'[Дата] ) )",
              "        VAR _mx_dt =",
              "            CALCULATE ( MAX ( '000 Календарь'[Дата] ), '000 Календарь'[Дата с Движениями] )",
              "        VAR _pr_year_mx_dt =",
              "            DATE ( YEAR ( _mx_dt ) - 1, MONTH ( _mx_dt ), DAY ( _mx_dt ) )",
              "        VAR _pr_year_min_dt =",
              "            DATE ( YEAR ( _mn_dt ) - 1, MONTH ( _mn_dt ), DAY ( _mn_dt ) )",
              "        VAR _end_of_mnth =",
              "            CALCULATE (",
              "                ENDOFMONTH ( '000 Календарь'[Дата] ),",
              "                '000 Календарь'[Дата с Движениями]",
              "            )",
              "        VAR _pr_year_mx_dt_full_mnth =",
              "            DATE ( YEAR ( _mx_dt ) - 1, MONTH ( _mx_dt ), DAY ( _end_of_mnth ) )",
              "        VAR _is_day_fltrd =",
              "            OR (",
              "                ISFILTERED ( '000 Календарь'[Дата] ),",
              "                ISFILTERED ( '000 Календарь'[Неделя] )",
              "            )",
              "        VAR _result =",
              "            CALCULATE (",
              "                [Продажи кг.],",
              "                '000 Календарь'[Дата] >= _pr_year_min_dt,",
              "                IF (",
              "                    NOT _is_day_fltrd,",
              "                    '000 Календарь'[Дата] <= _pr_year_mx_dt_full_mnth,",
              "                    '000 Календарь'[Дата] <= _pr_year_mx_dt",
              "                )",
              "            )",
              "        RETURN",
              "            _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Продажи\\Продажи кг."
          },
          {
            "name": "Продажи кг. (Отклонение к ПГ)",
            "expression": [
              "",
              "VAR _value = [Продажи кг.]",
              "VAR _value_py = [Продажи кг. (Прошлый год)]",
              "VAR _result = _value - _value_py",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Продажи\\Продажи кг."
          },
          {
            "name": "Продажи кг. (Отклонение к ПГ, %)",
            "expression": [
              "",
              "VAR _value = [Продажи кг.]",
              "VAR _value_py = [Продажи кг. (Прошлый год)]",
              "VAR _result =",
              "    IF (",
              "        NOT ISBLANK ( _value ) && ISBLANK ( _value_py ),",
              "        1,",
              "        IF (",
              "            NOT ISBLANK ( _value ) || NOT ISBLANK ( _value_py ),",
              "            DIVIDE ( _value, _value_py ) - 1",
              "        )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.0%;-#,0.0%;#,0.0%",
            "displayFolder": "Продажи\\Продажи кг."
          },
          {
            "name": "Продажи кг. (% от общего объема)",
            "expression": [
              "",
              "DIVIDE (",
              "    [Продажи кг.],",
              "    CALCULATE ( [Продажи кг.], ALLSELECTED ( '005 Номенклатура' ) )",
              ")",
              ""
            ],
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Продажи\\Продажи кг."
          },
          {
            "name": "Поступление ДС (реализация)",
            "expression": [
              "",
              "SUMX ( ",
              "    GROUPBY ( 'М001 Движения', '0091 Документы заказы клиентов'[ID Документ] ),",
              "    IF ( ",
              "        NOT ISBLANK ( [Реализация руб.] ),",
              "        CALCULATE (",
              "            [Поступление ДС],",
              "            KEEPFILTERS ( 'М002 Движения ДС'[Тип ДС] IN { \"Наличные\", \"Безналичные\" } ),",
              "            KEEPFILTERS ( '0091 Документы заказы клиентов'[Проведен] = \"Да\" ),",
              "            ALLEXCEPT ( '009 Документы движения', '009 Документы движения'[ID Документ] ),",
              "            REMOVEFILTERS ( '000 Календарь' )",
              "        )",
              "    )",
              ")",
              ""
            ],
            "formatString": "#,0.00",
            "displayFolder": "ДДС"
          },
          {
            "name": "Показать данные с датой",
            "expression": [
              "VAR LastDateWithData =",
              "    CALCULATE (",
              "        MAX ( '000 Календарь'[Дата] ),",
              "        REMOVEFILTERS (),",
              "        '000 Календарь'[Дата с Движениями]",
              "    )",
              "VAR FirstDateVisible =",
              "    MIN ( '000 Календарь'[Дата] )",
              "VAR Result = FirstDateVisible <= LastDateWithData",
              "RETURN",
              "    Result"
            ],
            "displayFolder": "Базовые меры"
          },
          {
            "name": "Дата поступления ДС",
            "expression": [
              "",
              "VAR Dt = ",
              "    CALCULATE (",
              "        MAX ( 'М002 Движения ДС'[Планируемая дата оплаты] ),",
              "        KEEPFILTERS ( 'М002 Движения ДС'[Тип ДС] IN { \"Наличные\", \"Безналичные\" } ),",
              "        KEEPFILTERS ( '0091 Документы заказы клиентов'[Проведен] = \"Да\" ),",
              "        ALLEXCEPT ( '009 Документы движения', '009 Документы движения'[ID Документ] ),",
              "        REMOVEFILTERS ( '000 Календарь' )",
              "    )",
              "RETURN",
              "    IF ( ",
              "        NOT ISBLANK ( [Реализация руб.] ) ",
              "            && ISINSCOPE ( '0091 Документы заказы клиентов'[Номер заказ клиента] ),",
              "        Dt",
              "    )",
              ""
            ],
            "formatString": "Short Date",
            "displayFolder": "ДДС",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"DateTimeShortDatePattern\" />"
              }
            ]
          },
          {
            "name": "Сумма заказа (реализация)",
            "expression": [
              "",
              "SUMX ( ",
              "    GROUPBY ( 'М001 Движения', '0091 Документы заказы клиентов'[ID Документ] ), ",
              "    IF ( ",
              "        NOT ISBLANK ( [Реализация руб.] ),",
              "        VAR N = ",
              "            CALCULATE ( ",
              "                [Заказ клиента (отгруженно), руб.],",
              "                REMOVEFILTERS ( '000 Календарь' )",
              "            )",
              "        VAR N1 = [Сумма заказа]",
              "        RETURN",
              "            IF ( ISBLANK ( N ), N1, N )",
              "    )",
              ")"
            ],
            "formatString": "#,0.00",
            "displayFolder": "ДДС"
          },
          {
            "name": "Кол-во уникальных клиентов",
            "expression": [
              "VAR _clc =",
              "    ADDCOLUMNS (",
              "        SUMMARIZE ( 'М001 Движения', '002 Контрагенты'[ID Контрагент] ),",
              "        \"@sls\", [Продажи ед.]",
              "    )",
              "VAR _result =",
              "    COUNTROWS ( FILTER ( _clc, NOT ISBLANK ( [@sls] ) ) )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Продажи"
          },
          {
            "name": "Кол-во уникальных SKU",
            "expression": [
              "VAR _clc =",
              "    ADDCOLUMNS (",
              "        SUMMARIZE ( 'М001 Движения', '005 Номенклатура'[ID Номенклатура] ),",
              "        \"@sls\", [Продажи ед.]",
              "    )",
              "VAR _result =",
              "    COUNTROWS ( FILTER ( _clc, NOT ISBLANK ( [@sls] ) ) )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Продажи"
          }
        ]
      },
