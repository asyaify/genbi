          },
          {
            "name": "Заказ поставщику, м.куб.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Движения, м.куб.],",
              "        KEEPFILTERS ( 'М001 Движения'[Вид движения] = -1 ),",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Заказ поставщику\" )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Заказ поставщику\\М.куб."
          },
          {
            "name": "Заказ поставщику, руб.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        SUM ( 'М001 Движения'[Сумма] ),",
              "        KEEPFILTERS ( 'М001 Движения'[Вид движения] = -1 ),",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Заказ поставщику\" )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Заказ поставщику\\Руб."
          },
          {
            "name": "Заказ клиента (не обеспеченно), руб.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ клиента, руб.],",
              "        'М001 Движения'[Вариант обеспечения]",
              "            IN { \"К обеспечению\", \"Обеспечивать обособленно\" },",
              "        ISBLANK ( 'М001 Движения'[ID Заказ Поставщику] )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Заказ клиента\\Руб."
          },
          {
            "name": "Заказ клиента (отгруженно), руб.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ клиента, руб.],",
              "        NOT ISBLANK ( 'М001 Движения'[ID Реализация] )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Заказ клиента\\Руб."
          },
          {
            "name": "Поступление с доп. расх., руб.",
            "expression": [
              "VAR _result =",
              "    CALCULATE (",
              "        [Движения, руб. Себестоимость],",
              "        KEEPFILTERS('009 Документы движения'[Документ Тип]",
              "            IN {",
              "            \"Возврат товаров поставщику\",",
              "            \"Корректировка приобретения\",",
              "            \"Оприходование излишков товаров\",",
              "            \"Поступление от переработчика\",",
              "            \"Приобретение услуг и прочих активов\",",
              "            \"Приобретение товаров и услуг\"",
              "        })",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Поступления"
          },
          {
            "name": "Возврат от клиента, кг.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Движения, кг.],",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Возврат товаров от клиента\" )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Заказ клиента\\Кг."
          },
          {
            "name": "Возврат от клиента, м.куб.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Движения, м.куб.],",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Возврат товаров от клиента\" )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Заказ клиента\\М.куб."
          },
          {
            "name": "Возврат от клиента, руб.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Движения Реализация без НДС],",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Возврат товаров от клиента\" )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Заказ клиента\\Руб."
          },
          {
            "name": "Рентабельность, %",
            "expression": [
              "",
              "DIVIDE ( [Валовая прибыль], [Реализация руб.] )",
              ""
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Валовая прибыль"
          },
          {
            "name": "Кол-во строк в документе",
            "expression": [
              "",
              "VAR N =",
              "    CALCULATE (",
              "        SUM ( '009 Документы движения'[Количество строк в документе] ),",
              "        RELATEDTABLE ( 'М001 Движения' )",
              "    )",
              "RETURN",
              "    SWITCH (",
              "        TRUE,",
              "        ISFILTERED ( '0091 Документы заказы клиентов' )",
              "            || ISFILTERED ( '0092 Документы запросы снабженцам' )",
              "            || ISFILTERED ( '0093 Документы реализации' )",
              "            || ISFILTERED ( '0094 Документы заказы поставщикам' )",
              "            || ISFILTERED ( '0095 Документы поступления' ),",
              "            IF (",
              "                NOT ISBLANK ( [Движения ед] ),",
              "                \"Использовать поля из таблицы '009 Документы движения'\"",
              "            ),",
              "        N",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "Базовые меры"
          },
          {
            "name": "Зарезервировано, ед.",
            "expression": [
              "",
              "SUM ( 'М001 Движения'[Количество Зарезервировано] )"
            ],
            "isHidden": true
          },
          {
            "name": "Зарезервировано, кг.",
            "expression": [
              "",
              "SUM ( 'М001 Движения'[Вес Зарезервировано] )"
            ],
            "isHidden": true
          },
          {
            "name": "Зарезервировано, м.куб.",
            "expression": [
              "",
              "SUM ( 'М001 Движения'[Объем Зарезервировано] )"
            ],
            "isHidden": true
          },
          {
            "name": "Остатки Начальные в Резерве, ед.",
            "expression": [
              "VAR clc =",
              "    CALCULATE (",
              "        [Зарезервировано, ед.],",
              "        FILTER (",
              "            ALL ( '000 Календарь' ),",
              "            '000 Календарь'[Дата] < MIN ( '000 Календарь'[Дата] )",
              "                && '000 Календарь'[Дата с Движениями]",
              "        ),",
              "        KEEPFILTERS ( NOT ( SIGN ( 'М001 Движения'[Вид движения] ) = -1 ) )",
              "    )",
              "VAR result =",
              "    IF ( [Показать данные с датой], clc )",
              "RETURN",
              "    result"
            ],
            "formatString": "#,0",
            "displayFolder": "Остатки\\Начальные"
          },
          {
            "name": "Остатки Конечные в Резерве, ед.",
            "expression": [
              "",
              "VAR _msr =",
              "    CALCULATE (",
              "        [Зарезервировано, ед.],",
              "        FILTER (",
              "            ALL ( '000 Календарь' ),",
              "            '000 Календарь'[Дата] <= MAX ( '000 Календарь'[Дата] )",
              "        ),",
              "        KEEPFILTERS ( NOT ( SIGN ( 'М001 Движения'[Вид движения] ) = -1 ) )",
              "    )",
              "VAR _result =",
              "    IF ( NOT ( ROUND ( _msr, 0 ) = 0 ) && [Показать данные с датой], _msr )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Остатки\\Конечные"
          },
          {
            "name": "Остатки Начальные в Резерве, кг.",
            "expression": [
              "VAR clc =",
              "    CALCULATE (",
              "        [Зарезервировано, кг.],",
              "        FILTER (",
              "            ALL ( '000 Календарь' ),",
              "            '000 Календарь'[Дата] < MIN ( '000 Календарь'[Дата] )",
              "        ),",
              "        KEEPFILTERS ( NOT ( SIGN ( 'М001 Движения'[Вид движения] ) = -1 ) ),",
              "        '000 Календарь'[Дата с Движениями]",
              "    )",
              "VAR result =",
              "    IF ( [Показать данные с датой], clc )",
              "RETURN",
              "    result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Остатки\\Начальные"
          },
          {
            "name": "Остатки Начальные в Резерве, м.куб.",
            "expression": [
              "VAR clc =",
              "    CALCULATE (",
              "        [Зарезервировано, м.куб.],",
              "        FILTER (",
              "            ALL ( '000 Календарь' ),",
              "            '000 Календарь'[Дата] < MIN ( '000 Календарь'[Дата] )",
              "        ),",
              "        KEEPFILTERS ( NOT ( SIGN ( 'М001 Движения'[Вид движения] ) = -1 ) ),",
              "        '000 Календарь'[Дата с Движениями]",
              "    )",
              "VAR result =",
              "    IF ( [Показать данные с датой], clc )",
              "RETURN",
              "    result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Остатки\\Начальные"
          },
          {
            "name": "Остатки Конечные в Резерве, кг.",
            "expression": [
              "",
              "VAR _msr =",
              "    CALCULATE (",
              "        [Зарезервировано, кг.],",
              "        FILTER (",
              "            ALL ( '000 Календарь' ),",
              "            '000 Календарь'[Дата] <= MAX ( '000 Календарь'[Дата] )",
              "        ),",
              "        KEEPFILTERS ( NOT ( SIGN ( 'М001 Движения'[Вид движения] ) = -1 ) )",
              "    )",
              "VAR _result =",
