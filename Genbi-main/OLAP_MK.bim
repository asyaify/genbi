            "formatString": "#,0.00",
            "displayFolder": "Заказ клиента\\М.куб."
          },
          {
            "name": "Поступления, м.куб.",
            "expression": [
              "VAR _result =",
              "    CALCULATE (",
              "        [Движения, м.куб.],",
              "        KEEPFILTERS('009 Документы движения'[Документ Тип]",
              "            IN {",
              "            \"Возврат товаров поставщику\",",
              "            \"Корректировка приобретения\",",
              "            \"Оприходование излишков товаров\",",
              "            \"Поступление от переработчика\",",
              "            \"Приобретение услуг и прочих активов\",",
              "            \"Приобретение товаров и услуг\"",
              "        })",
              "    )",
              "RETURN _result",
              ""
            ],
            "formatString": "#,0.00",
            "displayFolder": "Поступления"
          },
          {
            "name": "Остатки Начальные, м.куб.",
            "expression": [
              "--[Движения, м.куб.]",
              "VAR clc =",
              "    CALCULATE (",
              "        [Движения, м.куб.],",
              "        FILTER (",
              "            ALL ( '000 Календарь' ),",
              "            '000 Календарь'[Дата] < MIN ( '000 Календарь'[Дата] )",
              "        ),",
              "        KEEPFILTERS ( NOT ( SIGN ( 'М001 Движения'[Вид движения] ) = -1 ) )",
              "    )",
              "VAR result =",
              "    IF ( [Показать данные с датой], clc )",
              "RETURN",
              "    result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Остатки\\Начальные"
          },
          {
            "name": "Остатки Конечные, м.куб.",
            "expression": [
              "",
              "VAR _msr =",
              "    CALCULATE (",
              "        [Движения, м.куб.],",
              "        FILTER (",
              "            ALL ( '000 Календарь' ),",
              "            '000 Календарь'[Дата] <= MAX ( '000 Календарь'[Дата] )",
              "        ),",
              "        KEEPFILTERS ( NOT ( SIGN ( 'М001 Движения'[Вид движения] ) = -1 ) )",
              "    )",
              "VAR _result =",
              "    IF ( NOT ( ROUND ( _msr, 0 ) = 0 ) && [Показать данные с датой], _msr )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Остатки\\Конечные"
          },
          {
            "name": "Кол-во выставленных счетов",
            "expression": [
              "",
              "CALCULATE ( ",
              "    DISTINCTCOUNT ( 'М001 Движения'[Документ] ),",
              "    KEEPFILTERS ('009 Документы движения'[Документ Тип] = \"заказ клиента\" ),",
              "    KEEPFILTERS ( NOT ISBLANK ( '004 Партнеры'[Основной менеджер] ) ),",
              "    KEEPFILTERS ( '009 Документы движения'[Проведен] = \"да\" )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "ДДС"
          },
          {
            "name": "Кол-во оплаченных счетов",
            "expression": [
              "",
              "VAR t = ",
              "    GROUPBY (",
              "        CALCULATETABLE ( ",
              "            GROUPBY ( ",
              "                'М002 Движения ДС',",
              "                [ID Документ],",
              "                [ID Пользователь],",
              "                [ID Заказ]",
              "            ),",
              "            KEEPFILTERS ( 'М002 Движения ДС'[Тип ДС] = \"расчеты с клиентами\" ),",
              "            KEEPFILTERS ( NOT ISBLANK ( '004 Партнеры'[Основной менеджер] ) )",
              "        ),",
              "        [ID Пользователь],",
              "        [ID Документ],",
              "        \"@Cnt\",",
              "        COUNTX ( CURRENTGROUP(), [ID Заказ] )",
              "    )",
              "RETURN",
              "    SUMX ( t, [@Cnt] )",
              "",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "ДДС"
          },
          {
            "name": "Кол-во неоплаченных счетов",
            "expression": [
              "",
              "VAR N = ",
              "    [Кол-во выставленных счетов] - [Кол-во оплаченных счетов]",
              "RETURN",
              "    IF ( N > 0, N )"
            ],
            "formatString": "#,0",
            "displayFolder": "ДДС"
          },
          {
            "name": "Остатки Начальные, руб.",
            "expression": [
              "--[Движения, руб. Себестоимость]",
              "VAR clc =",
              "    CALCULATE (",
              "        [Движения, руб. Себестоимость],",
              "        FILTER (",
              "            ALL ( '000 Календарь' ),",
              "            '000 Календарь'[Дата] < MIN ( '000 Календарь'[Дата] )",
              "        ),",
              "        KEEPFILTERS ( NOT ( SIGN ( 'М001 Движения'[Вид движения] ) = -1 ) )",
              "    )",
              "VAR result =",
              "    IF ( [Показать данные с датой], clc )",
              "RETURN",
              "    result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Остатки\\Начальные"
          },
          {
            "name": "Остатки Конечные, руб.",
            "expression": [
              "VAR clc =",
              "    CALCULATE (",
              "        [Движения, руб. Себестоимость],",
              "        FILTER (",
              "            ALL ( '000 Календарь' ),",
              "            '000 Календарь'[Дата] <= MAX ( '000 Календарь'[Дата] )",
              "        )",
              "    )",
              "VAR result =",
              "    IF ( [Показать данные с датой], clc )",
              "RETURN",
              "    result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Остатки\\Конечные"
          },
          {
            "name": "Движения, руб. Себестоимость",
            "expression": [
              "",
              "SUM ( 'М001 Движения'[Стоимость] )"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Базовые меры"
          },
          {
            "name": "Заказ клиента, руб.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        SUM([Сумма]),",
              "        KEEPFILTERS ( 'М001 Движения'[Вид движения] = -1 ),",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Заказ клиента\" )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Заказ клиента\\Руб."
          },
          {
            "name": "Запрос снабженцу, м.куб.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Движения, м.куб.],",
              "        KEEPFILTERS ( 'М001 Движения'[Вид движения] = -1 ),",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Запрос снабженцу\" )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Запрос снабженцу"
          },
          {
            "name": "Обеспечивать обособленно, руб.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ клиента, руб.],",
              "        'М001 Движения'[Вариант обеспечения] IN { \"Обеспечивать обособленно\" }",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Заказ клиента\\Руб."
          },
          {
            "name": "Отгрузить по заказу, руб.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ клиента, руб.],",
              "        'М001 Движения'[Вариант обеспечения] IN { \"Отгрузить\" }",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Заказ клиента\\Руб."
          },
          {
            "name": "Заказ клиента (в заказе поставщику), ед.",
            "expression": [
              "",
              "    VAR _result =",
              "        CALCULATE (",
              "            [Заказ клиента, ед.],",
              "            'М001 Движения'[Вариант обеспечения]",
              "                IN { \"Резервировать к дате\", \"К обеспечению\", \"Обеспечивать обособленно\" },",
              "            NOT ISBLANK ( 'М001 Движения'[ID Заказ Поставщику] ),",
              "            ISBLANK ( 'М001 Движения'[ID Реализация] ),",
              "            ISBLANK ( 'М001 Движения'[ID Приобретение] )",
              "        )",
              "    RETURN",
              "        _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ клиента\\Ед."
          },
          {
            "name": "Заказ клиента (не обеспеченно), ед.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ клиента, ед.],",
              "        'М001 Движения'[Вариант обеспечения]",
              "            IN { \"К обеспечению\", \"Обеспечивать обособленно\" },",
              "        ISBLANK ( 'М001 Движения'[ID Заказ Поставщику] )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ клиента\\Ед."
          },
          {
            "name": "Заказ клиента (отгруженно), ед.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ клиента, ед.],",
              "        NOT ISBLANK ( 'М001 Движения'[ID Реализация] )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ клиента\\Ед."
          },
          {
            "name": "Кол-во SKU в заказе клиента",
            "expression": [
              "",
              "VAR _bs_tbl =",
              "    ADDCOLUMNS (",
              "        SUMMARIZE ( 'М001 Движения', '005 Номенклатура'[ID Номенклатура] ),",
              "        \"@заказ_клиента\", [Заказ клиента, ед.]",
              "    )",
              "VAR _result =",
              "    COUNTROWS ( FILTER ( _bs_tbl, NOT ISBLANK ( [@заказ_клиента] ) ) )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ клиента"
          },
          {
            "name": "Кол-во реализаций",
            "expression": [
              "VAR _bs_tbl =",
              "    CALCULATETABLE (",
              "        ADDCOLUMNS (",
              "            SUMMARIZE ( 'М001 Движения', '009 Документы движения'[ID Документ] ),",
              "            \"@движения\", [Движения ед]",
              "        ),",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Реализация товаров и услуг\" )",
              "    )",
              "VAR _result =",
              "    COUNTROWS ( FILTER ( _bs_tbl, NOT ISBLANK ( [@движения] ) ) )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Продажи"
          },
          {
            "name": "Возврат от клиента, ед.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Движения ед],",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Возврат товаров от клиента\" )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ клиента\\Ед."
          },
          {
            "name": "Продажи кг.",
            "expression": [
              "",
              "- CALCULATE (",
              "    [Движения, кг.],",
              "    'М001 Движения'[Вид движения],",
              "    KEEPFILTERS ( '009 Документы движения'[Документ тип]",
              "        IN {",
              "        \"Возврат товаров от клиента\",",
              "        \"Корректировка реализации\",",
              "        \"Отчет комиссионера (агента) о продажах\",",
              "        \"Реализация товаров и услуг\",",
              "        \"Отчет о розничных продажах\"",
              "    } ",
              "   )",
              ")"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Продажи\\Продажи кг."
          },
          {
            "name": "Реализация руб.",
            "expression": [
              "",
              "[Движения Реализация]"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Продажи\\Продажи руб."
          },
          {
            "name": "Дата нового клиента",
            "expression": [
              "VAR _result =",
              "    CALCULATE (",
              "        MIN ( 'М001 Движения'[Дата] ),",
              "        ALLEXCEPT ( 'М001 Движения', 'М001 Движения'[Контрагент], '002 Контрагенты' )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Продажи"
          },
          {
            "name": "Кол-во новых клиентов",
            "expression": [
              "VAR CustomersWithNewDate =",
              "    CALCULATETABLE (",
              "        ADDCOLUMNS (",
              "            VALUES ( 'М001 Движения'[Контрагент] ),",
              "            \"@NewCustomerDate\", [Дата нового клиента]",
              "        ),",
              "        ALLSELECTED ( '002 Контрагенты' ),",
              "        ALLSELECTED ( '000 Календарь' )",
              "    )",
              "VAR CustomersWithLineage =",
              "    TREATAS (",
              "        CustomersWithNewDate,",
              "        '002 Контрагенты'[ID Контрагент],",
              "        '000 Календарь'[Дата]",
              "    )",
              "VAR Result =",
              "    CALCULATE (",
              "        DISTINCTCOUNT ( 'М001 Движения'[Контрагент] ),",
              "        KEEPFILTERS ( CustomersWithLineage )",
              "    )",
              "RETURN",
              "    Result"
            ],
            "formatString": "#,0",
            "displayFolder": "Продажи"
          },
          {
            "name": "Кол-во вернувшихся клиентов",
            "expression": [
              "VAR MinDate = MIN ( '000 Календарь'[Дата] )",
              "VAR CustomersWithNewDate =",
              "    CALCULATETABLE (                        ",
              "        ADDCOLUMNS (                        ",
              "            VALUES ( 'М001 Движения'[Контрагент] ),  ",
              "            \"@NewCustomerDate\", [Дата нового клиента]",
              "        ),",
              "        ALLSELECTED ( '002 Контрагенты' ),         ",
              "        ALLSELECTED ( '000 Календарь' )            ",
              "    )",
              "VAR ExistingCustomers =                  ",
              "    FILTER (                              ",
              "        CustomersWithNewDate,             ",
              "        [@NewCustomerDate] < MinDate      ",
              "    )",
              "VAR ReturningCustomers =                  ",
              "    INTERSECT (                           ",
              "        VALUES ( 'М001 Движения'[Контрагент] ),    ",
              "        SELECTCOLUMNS (                   ",
              "            ExistingCustomers,",
              "            \"Контрагент\", 'М001 Движения'[Контрагент]",
              "        )",
              "    )",
              "VAR Result =",
              "    COUNTROWS ( ReturningCustomers )     ",
              "RETURN",
              "    Result"
            ],
            "formatString": "#,0",
            "displayFolder": "Продажи"
          },
          {
            "name": "Средний оплаченный счет, руб.",
            "expression": [
              "",
              "VAR t_Inv = ",
              "    CALCULATETABLE ( ",
              "        SUMMARIZE (",
              "            'М002 Движения ДС',",
              "            '000 Календарь'[Дата],",
              "            [ID Пользователь],",
              "            \"@Sum\", - CALCULATE ( SUM ( 'М002 Движения ДС'[Сумма Регл] ) ),",
              "            \"@Cnt\", CALCULATE ( DISTINCTCOUNT ( 'М002 Движения ДС'[ID Заказ] ) )",
              "            ),",
              "        KEEPFILTERS ( 'М002 Движения ДС'[Тип ДС] = \"расчеты с клиентами\" ),",
              "        KEEPFILTERS ( NOT ISBLANK ( '004 Партнеры'[Основной менеджер] ) )",
              "    )",
              "/*VAR Sum_Inv = ",
              "  -  CALCULATE (",
              "        SUM ( 'М002 Движения ДС'[Сумма Регл] ),",
              "        NOT ISBLANK ( '004 Партнеры'[Основной менеджер] )",
              "    )",
              "VAR Cnt_Inv = ",
              "   CALCULATE (",
              "        DISTINCTCOUNT ( 'М002 Движения ДС'[ID Заказ] ),",
              "        NOT ISBLANK ( '004 Партнеры'[Основной менеджер] )",
              "    )*/ ",
              "RETURN",
              "    --DIVIDE ( Sum_Inv, Cnt_Inv )",
              "    DIVIDE ( SUMX ( t_Inv, [@Sum] ), SUMX ( t_Inv, [@Cnt] ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "ДДС"
          },
          {
            "name": "Заказ поставщику, кг.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Движения, кг.],",
              "        KEEPFILTERS ( 'М001 Движения'[Вид движения] = -1 ),",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Заказ поставщику\" )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Заказ поставщику\\Кг."
          },
          {
            "name": "Заказ клиента (не обеспеченно), кг.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ клиента, кг.],",
              "        'М001 Движения'[Вариант обеспечения]",
              "            IN { \"К обеспечению\", \"Обеспечивать обособленно\" },",
              "        ISBLANK ( 'М001 Движения'[ID Заказ Поставщику] )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Заказ клиента\\Кг."
          },
