          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/CHGRKTS01;DWH_MIRKREP\",",
                "    #\"ast_vf Movements\" = Source{[Schema=\"ast\",Item=\"vf Movements\"]}[Data]",
                "in",
                "    #\"ast_vf Movements\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Движения ед",
            "expression": [
              "",
              "SUM ( 'М001 Движения'[Количество] )"
            ],
            "formatString": "#,0",
            "displayFolder": "Базовые меры"
          },
          {
            "name": "Остатки Начальные ед",
            "expression": [
              "",
              "VAR clc =",
              "    CALCULATE (",
              "        [Движения ед],",
              "        FILTER (",
              "            ALL ( '000 Календарь' ),",
              "            '000 Календарь'[Дата] < MIN ( '000 Календарь'[Дата] )",
              "        ),",
              "        KEEPFILTERS ( NOT ( SIGN ( 'М001 Движения'[Вид движения] ) = -1 ) )",
              "    )",
              "VAR result =",
              "    IF ( [Показать данные с датой], clc )",
              "RETURN",
              "    result"
            ],
            "formatString": "#,0",
            "displayFolder": "Остатки\\Начальные"
          },
          {
            "name": "Остатки Конечные ед",
            "expression": [
              "",
              "VAR _msr =",
              "    CALCULATE (",
              "        [Движения ед],",
              "        FILTER (",
              "            ALL ( '000 Календарь' ),",
              "            '000 Календарь'[Дата] <= MAX ( '000 Календарь'[Дата] )",
              "        ),",
              "        KEEPFILTERS ( NOT ( SIGN ( 'М001 Движения'[Вид движения] ) = -1 ) )",
              "    )",
              "VAR _result =",
              "    IF ( NOT ( ROUND ( _msr, 0 ) = 0 ) && [Показать данные с датой], _msr )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Остатки\\Конечные"
          },
          {
            "name": "Приход кол-во",
            "expression": [
              "",
              "CALCULATE ( [Движения ед], KEEPFILTERS ( NOT 'М001 Движения'[Вид движения] ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "Базовые меры\\Приход"
          },
          {
            "name": "Расход кол-во",
            "expression": [
              "",
              "CALCULATE ( - [Движения ед], KEEPFILTERS ( 'М001 Движения'[Вид движения] = 1 ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "Базовые меры\\Расход"
          },
          {
            "name": "Валовая прибыль",
            "expression": [
              "",
              "VAR Cost = ",
              "    [Себестоимость]",
              "VAR Rev = ",
              "    [Реализация руб.]",
              "RETURN",
              "    IF ( Cost = 0 && Rev <> 0, 0, Rev - Cost )"
            ],
            "formatString": "#,0",
            "displayFolder": "Валовая прибыль"
          },
          {
            "name": "Валовая прибыль (Прошлый год)",
            "expression": [
              "--[Валовая прибыль]",
              "VAR _mn_dt =",
              "            CALCULATE ( MIN ( '000 Календарь'[Дата] ) )",
              "        VAR _mx_dt =",
              "            CALCULATE ( MAX ( '000 Календарь'[Дата] ), '000 Календарь'[Дата с Движениями] )",
              "        VAR _pr_year_mx_dt =",
              "            DATE ( YEAR ( _mx_dt ) - 1, MONTH ( _mx_dt ), DAY ( _mx_dt ) )",
              "        VAR _pr_year_min_dt =",
              "            DATE ( YEAR ( _mn_dt ) - 1, MONTH ( _mn_dt ), DAY ( _mn_dt ) )",
              "        VAR _end_of_mnth =",
              "            CALCULATE (",
              "                ENDOFMONTH ( '000 Календарь'[Дата] ),",
              "                '000 Календарь'[Дата с Движениями]",
              "            )",
              "        VAR _pr_year_mx_dt_full_mnth =",
              "            DATE ( YEAR ( _mx_dt ) - 1, MONTH ( _mx_dt ), DAY ( _end_of_mnth ) )",
              "        VAR _is_day_fltrd =",
              "            OR (",
              "                ISFILTERED ( '000 Календарь'[Дата] ),",
              "                ISFILTERED ( '000 Календарь'[Неделя] )",
              "            )",
              "        VAR _result =",
              "            CALCULATE (",
              "                [Валовая прибыль],",
              "                '000 Календарь'[Дата] >= _pr_year_min_dt,",
              "                IF (",
              "                    NOT _is_day_fltrd,",
              "                    '000 Календарь'[Дата] <= _pr_year_mx_dt_full_mnth,",
              "                    '000 Календарь'[Дата] <= _pr_year_mx_dt",
              "                )",
              "            )",
              "        RETURN",
              "            _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Валовая прибыль"
          },
          {
            "name": "Валовая прибыль (Отклонение к ПГ)",
            "expression": [
              "",
              "VAR _value = [Валовая прибыль]",
              "VAR _value_py = [Валовая прибыль (Прошлый год)]",
              "VAR _result = _value - _value_py",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Валовая прибыль"
          },
          {
            "name": "Валовая прибыль (Отклонение к ПГ, %)",
            "expression": [
              "",
              "VAR _value = [Валовая прибыль]",
              "VAR _value_py = [Валовая прибыль (Прошлый год)]",
              "VAR _result =",
              "    IF (",
              "        NOT ISBLANK ( _value ) && ISBLANK ( _value_py ),",
              "        1,",
              "        IF (",
              "            NOT ISBLANK ( _value ) || NOT ISBLANK ( _value_py ),",
              "            DIVIDE ( _value, _value_py ) - 1",
              "        )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.0%;-#,0.0%;#,0.0%",
            "displayFolder": "Валовая прибыль"
          },
          {
            "name": "Продажи ед.",
            "expression": [
              "",
              "- CALCULATE (",
              "    [Движения ед],",
              "    'М001 Движения'[Вид движения],",
              "    KEEPFILTERS ( '009 Документы движения'[Документ тип]",
              "        IN {",
              "        \"Возврат товаров от клиента\",",
              "        \"Корректировка реализации\",",
              "        \"Отчет комиссионера (агента) о продажах\",",
              "        \"Реализация товаров и услуг\",",
              "        \"Отчет о розничных продажах\"",
              "    } ",
              "   )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Продажи\\Продажи ед."
          },
          {
            "name": "Продажи ед. (% от общего объема)",
            "expression": [
              "",
              "DIVIDE (",
              "    [Продажи ед.],",
              "    CALCULATE ( [Продажи ед.], ALLSELECTED ( '005 Номенклатура' ) )",
              ")",
              ""
            ],
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Продажи\\Продажи ед."
          },
          {
            "name": "Движения ДС Факт",
            "expression": [
              "",
              "VAR _Row = ",
              "    CALCULATE (",
              "        IF ( ",
              "            ISFILTERED ( 'М002 Движения ДС'[Валюта] ),",
              "            SUM ( 'М002 Движения ДС'[Сумма] ),",
              "            SUM ( 'М002 Движения ДС'[Сумма Регл] )",
              "        ),",
              "        KEEPFILTERS ( 'М002 Движения ДС'[Тип ДС] <> \"расчеты с клиентами\" ),",
              "        NOT 'М002 Движения ДС'[План]",
              "    )",
              "VAR Total = ",
              "    CALCULATE (",
              "        IF ( ",
              "            ISFILTERED ( 'М002 Движения ДС'[Валюта] ),",
              "            SUM ( 'М002 Движения ДС'[Сумма] ),",
              "            SUM ( 'М002 Движения ДС'[Сумма Регл] )",
              "        ),",
              "        KEEPFILTERS ( NOT 'М002 Движения ДС'[Тип ДС] IN  { \"расчеты с клиентами\", \"Денежные средства в пути\" } ),",
              "        NOT 'М002 Движения ДС'[План]",
              "    )",
              "RETURN",
              "    IF ( ISINSCOPE ( 'М002 Движения ДС'[Тип ДС] ), _Row, Total )"
            ],
            "formatString": "#,0",
            "displayFolder": "Базовые меры"
          },
          {
            "name": "Поступление ДС",
            "expression": [
              " ",
              "CALCULATE ( ",
              "        [Движения ДС Факт],",
              "        NOT 'М002 Движения ДС'[Тип движения]",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "ДДС"
          },
          {
            "name": "Списание ДС",
            "expression": [
              " ",
              "- CALCULATE ( ",
              "        [Движения ДС Факт],",
              "         'М002 Движения ДС'[Тип движения]",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "ДДС"
          },
          {
            "name": "Остаток ДС на начало периода",
            "expression": [
              " ",
              "VAR Mn =  MIN ( '000 Календарь'[Дата] )",
              "RETURN",
              "     IF ( ",
              "        NOT ISINSCOPE ( '010 Статьи ДДС'[Наименование статьи ДДС уровень 1] ),",
              "        CALCULATE ( ",
              "            [Движения ДС Факт],",
              "            '000 Календарь'[Дата] < Mn,",
              "            REMOVEFILTERS ( '000 Календарь' )",
              "       )",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "ДДС"
          },
          {
            "name": "Остаток ДС на конец периода",
            "expression": [
              " ",
              "VAR Mx =  MAX ( '000 Календарь'[Дата] )",
              "RETURN",
              "     IF ( ",
              "        NOT ISINSCOPE ( '010 Статьи ДДС'[Наименование статьи ДДС уровень 1] ),",
              "        CALCULATE ( ",
              "            [Движения ДС Факт],",
              "            '000 Календарь'[Дата] <= Mx,",
              "            REMOVEFILTERS ( '000 Календарь' )",
              "       )",
              "    )"
            ],
            "formatString": "#,0",
            "displayFolder": "ДДС"
          },
          {
            "name": "Списание ДС План",
            "expression": [
              " ",
              "CALCULATE ( ",
              "        [Движения ДС План],",
              "        NOT  'М002 Движения ДС'[Тип движения]",
              "",
              " )"
            ],
            "formatString": "#,0",
            "isHidden": true,
            "displayFolder": "ДДС"
          },
          {
            "name": "Движения ДС План",
            "expression": [
              "",
              "CALCULATE (",
              "    SUM ( 'М002 Движения ДС'[Сумма] ),",
              "    'М002 Движения ДС'[План]",
              ")"
            ],
            "formatString": "#,0",
            "isHidden": true,
            "displayFolder": "Базовые меры"
          },
          {
            "name": "Упр Движения ДС",
            "expression": [
              "",
              "VAR Mn =  MIN ( '000 Календарь'[Дата] )",
              "VAR Mx =  MAX ( '000 Календарь'[Дата] )",
              "VAR N1 = ",
              "    CALCULATE ( ",
              "        [Движения ДС Факт],",
              "        '000 Календарь'[Дата] < Mn,",
              "        REMOVEFILTERS ( '000 Календарь' ),",
              "        REMOVEFILTERS ( '010 Статьи ДДС' ),",
              "        KEEPFILTERS (  'М002 Движения ДС'[Тип ДС] <> \"денежные средства в пути\" )  ",
              "    )",
              "VAR N2 = ",
              "    CALCULATE ( ",
              "        [Движения ДС Факт],",
              "        '000 Календарь'[Дата] <= Mx,",
              "        REMOVEFILTERS ( '000 Календарь' ),",
              "        REMOVEFILTERS ( '010 Статьи ДДС' ) ,",
              "        KEEPFILTERS (  'М002 Движения ДС'[Тип ДС] <> \"денежные средства в пути\" )",
              "    )",
              "VAR N3 = ",
              "    CALCULATE ( ",
              "        [Движения ДС Факт],",
              "        KEEPFILTERS (  'М002 Движения ДС'[Тип ДС] <> \"денежные средства в пути\" ),",
              "        REMOVEFILTERS ( '010 Статьи ДДС' ) )",
              "VAR Res = ",
              "    SWITCH (",
              "        SELECTEDVALUE ( '010 Статьи ДДС'[Наименование статьи ДДС уровень 1] ),",
              "        \"начальный остаток\", N1,",
              "        \"конечный остаток\", N2,",
              "        \"результирующий дп\", N3,",
              "        CALCULATE ( [Движения ДС Факт], KEEPFILTERS (  'М002 Движения ДС'[Тип ДС] <> \"денежные средства в пути\" ) )",
              "    ) ",
              "RETURN",
              "    SWITCH ( ",
              "        TRUE,",
              "        ISINSCOPE ( '010 Статьи ДДС'[Наименование статьи ДДС уровень 3] ) ",
              "            && ISBLANK ( SELECTEDVALUE ( '010 Статьи ДДС'[Наименование статьи ДДС уровень 3] ) ), BLANK(),",
              "        ISINSCOPE ( '010 Статьи ДДС'[Наименование статьи ДДС уровень 2] ) ",
              "            && ISBLANK ( SELECTEDVALUE ( '010 Статьи ДДС'[Наименование статьи ДДС уровень 2] ) ), BLANK(),",
              "        Res",
              "    )"
            ],
            "formatString": "#,##0;(#,##0);-",
            "displayFolder": "ДДС"
          },
          {
            "name": "Движения Реализация",
            "expression": [
              "",
              "-SUM ( 'М001 Движения'[Выручка] )"
            ],
            "formatString": "#,0",
            "displayFolder": "Базовые меры"
          },
          {
            "name": "Приход СБС",
            "expression": [
              "",
              "CALCULATE ( [Движения, руб. Себестоимость], KEEPFILTERS ( NOT 'М001 Движения'[Вид движения] ) )"
            ],
            "formatString": "#,0",
            "displayFolder": "Базовые меры\\Приход"
          },
          {
            "name": "Расход СБС",
            "expression": [
              "",
              "CALCULATE (",
              "    - [Движения, руб. Себестоимость],",
              "    KEEPFILTERS ( 'М001 Движения'[Вид движения] = 1 )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Базовые меры\\Расход"
          },
          {
            "name": "Движения СБС без НДС",
            "expression": [
              "",
              "SUM ( 'М001 Движения'[Стоимостьбезндс] )"
            ],
            "formatString": "#,0",
            "displayFolder": "Базовые меры"
          },
          {
            "name": "Движения Реализация без НДС",
            "expression": [
              "",
              "-SUM ( 'М001 Движения'[Выручка без НДС] )"
            ],
            "formatString": "#,0",
            "displayFolder": "Базовые меры"
          },
          {
            "name": "Приход СБС без НДС",
            "expression": [
              "",
              "CALCULATE (",
              "    [Движения СБС без НДС],",
              "    KEEPFILTERS ( NOT 'М001 Движения'[Вид движения] )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Базовые меры\\Приход"
          },
          {
            "name": "Расход СБС без НДС",
            "expression": [
              "",
              "CALCULATE (",
              "    - [Движения СБС без НДС],",
              "    KEEPFILTERS ( 'М001 Движения'[Вид движения] = 1 )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "Базовые меры\\Расход"
          },
          {
            "name": "Реализация руб. (Прошлый год)",
            "expression": [
              "",
              "--[Реализация руб.]",
              "",
              "VAR _mn_dt =",
              "            CALCULATE ( MIN ( '000 Календарь'[Дата] ) )",
              "        VAR _mx_dt =",
              "            CALCULATE ( MAX ( '000 Календарь'[Дата] ), '000 Календарь'[Дата с Движениями] )",
              "        VAR _pr_year_mx_dt =",
              "            DATE ( YEAR ( _mx_dt ) - 1, MONTH ( _mx_dt ), DAY ( _mx_dt ) )",
              "        VAR _pr_year_min_dt =",
              "            DATE ( YEAR ( _mn_dt ) - 1, MONTH ( _mn_dt ), DAY ( _mn_dt ) )",
              "        VAR _end_of_mnth =",
              "            CALCULATE (",
              "                ENDOFMONTH ( '000 Календарь'[Дата] ),",
              "                '000 Календарь'[Дата с Движениями]",
              "            )",
              "        VAR _pr_year_mx_dt_full_mnth =",
              "            DATE ( YEAR ( _mx_dt ) - 1, MONTH ( _mx_dt ), DAY ( _end_of_mnth ) )",
              "        VAR _is_day_fltrd =",
              "            OR (",
              "                ISFILTERED ( '000 Календарь'[Дата] ),",
              "                ISFILTERED ( '000 Календарь'[Неделя] )",
              "            )",
              "        VAR _result =",
              "            CALCULATE (",
              "                [Реализация руб.],",
              "                '000 Календарь'[Дата] >= _pr_year_min_dt,",
              "                IF (",
              "                    NOT _is_day_fltrd,",
              "                    '000 Календарь'[Дата] <= _pr_year_mx_dt_full_mnth,",
              "                    '000 Календарь'[Дата] <= _pr_year_mx_dt",
              "                )",
              "            )",
              "        RETURN",
              "            _result"
            ],
            "displayFolder": "Продажи\\Продажи руб."
          },
          {
            "name": "Реализация руб. (Отклонение к ПГ)",
            "expression": [
              "",
              "VAR _value = [Реализация руб.]",
              "VAR _value_py = [Реализация руб. (Прошлый год)]",
              "VAR _result = _value - _value_py",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Продажи\\Продажи руб."
          },
          {
            "name": "Реализация руб. (Отклонение к ПГ, %)",
            "expression": [
              "",
              "VAR _value = [Реализация руб.]",
              "VAR _value_py = [Реализация руб. (Прошлый год)]",
              "VAR _result =",
              "    IF (",
              "        NOT ISBLANK ( _value ) && ISBLANK ( _value_py ),",
              "        1,",
              "        IF (",
              "            NOT ISBLANK ( _value ) || NOT ISBLANK ( _value_py ),",
              "            DIVIDE ( _value, _value_py ) - 1",
              "        )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.0%;-#,0.0%;#,0.0%",
            "displayFolder": "Продажи\\Продажи руб."
          },
          {
            "name": "Реализация руб. (% от общего объема)",
            "expression": [
              "",
              "",
              "DIVIDE (",
              "    [Реализация руб.],",
              "    CALCULATE ( [Реализация руб.], ALLSELECTED ( '005 Номенклатура' ) )",
              ")"
            ],
            "formatString": "#,0.0%;-#,0.0%;#,0.0%",
            "displayFolder": "Продажи\\Продажи руб."
          },
          {
            "name": "Себестоимость",
            "expression": [
              "",
              "        VAR _result =",
              "            CALCULATE (",
              "                [Движения, руб. Себестоимость],",
              "                'М001 Движения'[Вид движения] = 1,",
              "                KEEPFILTERS ( '009 Документы движения'[Документ тип]",
              "                    IN {",
              "                    \"Возврат товаров от клиента\",",
              "                    \"Корректировка реализации\",",
              "                    \"Отчет комиссионера (агента) о продажах\",",
              "                    \"Отчет о розничных продажах\",",
              "                    \"Реализация товаров и услуг\"",
              "                } )",
              "            )",
              "        RETURN",
              "             -_result"
            ],
            "formatString": "#,0",
            "displayFolder": "Себестоимость"
          },
          {
            "name": "Себестоимость (Прошлый год)",
            "expression": [
              "",
              "--[Себестоимость]",
              "VAR _mn_dt =",
              "            CALCULATE ( MIN ( '000 Календарь'[Дата] ) )",
              "        VAR _mx_dt =",
              "            CALCULATE ( MAX ( '000 Календарь'[Дата] ), '000 Календарь'[Дата с Движениями] )",
              "        VAR _pr_year_mx_dt =",
              "            DATE ( YEAR ( _mx_dt ) - 1, MONTH ( _mx_dt ), DAY ( _mx_dt ) )",
              "        VAR _pr_year_min_dt =",
              "            DATE ( YEAR ( _mn_dt ) - 1, MONTH ( _mn_dt ), DAY ( _mn_dt ) )",
              "        VAR _end_of_mnth =",
              "            CALCULATE (",
              "                ENDOFMONTH ( '000 Календарь'[Дата] ),",
              "                '000 Календарь'[Дата с Движениями]",
              "            )",
              "        VAR _pr_year_mx_dt_full_mnth =",
              "            DATE ( YEAR ( _mx_dt ) - 1, MONTH ( _mx_dt ), DAY ( _end_of_mnth ) )",
              "        VAR _is_day_fltrd =",
              "            OR (",
              "                ISFILTERED ( '000 Календарь'[Дата] ),",
              "                ISFILTERED ( '000 Календарь'[Неделя] )",
              "            )",
              "        VAR _result =",
              "            CALCULATE (",
              "                [Себестоимость],",
              "                '000 Календарь'[Дата] >= _pr_year_min_dt,",
              "                IF (",
              "                    NOT _is_day_fltrd,",
              "                    '000 Календарь'[Дата] <= _pr_year_mx_dt_full_mnth,",
              "                    '000 Календарь'[Дата] <= _pr_year_mx_dt",
              "                )",
              "            )",
              "        RETURN",
              "            _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Себестоимость"
          },
          {
            "name": "Себестоимость (Отклонение к ПГ)",
            "expression": [
              "",
              "VAR _value = [Себестоимость]",
              "VAR _value_py = [Себестоимость (Прошлый год)]",
              "VAR _result = _value - _value_py",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Себестоимость"
          },
          {
            "name": "Себестоимость (Отклонение к ПГ, %)",
            "expression": [
              "",
              "VAR _value = [Себестоимость]",
              "VAR _value_py = [Себестоимость (Прошлый год)]",
              "VAR _result =",
              "    IF (",
              "        NOT ISBLANK ( _value ) && ISBLANK ( _value_py ),",
              "        1,",
              "        IF (",
              "            NOT ISBLANK ( _value ) || NOT ISBLANK ( _value_py ),",
              "            DIVIDE ( _value, _value_py ) - 1",
              "        )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0.0%;-#,0.0%;#,0.0%",
            "displayFolder": "Себестоимость"
          },
          {
            "name": "Заказ клиента, ед.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Движения ед],",
              "        KEEPFILTERS ( 'М001 Движения'[Вид движения] = -1 ),",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Заказ клиента\" )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ клиента\\Ед."
          },
          {
            "name": "Заказ поставщику, ед.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Движения ед],",
              "        KEEPFILTERS ( 'М001 Движения'[Вид движения] = -1 ),",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Заказ поставщику\" )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ поставщику\\Ед."
          },
          {
            "name": "Запрос снабженцу, ед.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Движения ед],",
              "        KEEPFILTERS ( 'М001 Движения'[Вид движения] = -1 ),",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Запрос снабженцу\" )",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Запрос снабженцу"
          },
          {
            "name": "Сумма заказа",
            "expression": [
              "",
              "CALCULATE ( ",
              "    SUM ( '0091 Документы заказы клиентов'[Сумма Документа] ),",
              "    KEEPFILTERS (  '0091 Документы заказы клиентов'[Проведен] = \"Да\" ),",
              "    RELATEDTABLE ( 'М002 Движения ДС' )",
              ")",
              "    ",
              "/*SUMX ( ",
              "    VALUES ( '0091 Документы заказы клиентов'[ID Документ] ),",
              "    CALCULATE ( ",
              "       AVERAGE (  'М002 Движения ДС'[Сумма Заказ] ),",
              "        KEEPFILTERS ( '009 Документы движения'[Документ Тип] = \"Поступление безналичных денежных средств\" ),",
              "        KEEPFILTERS (  'М002 Движения ДС'[Тип ДС] = \"безналичные\" ),",
              "        KEEPFILTERS (  '0091 Документы заказы клиентов'[Проведен] = \"Да\" ) ",
              "     )",
              ")*/"
            ],
            "formatString": "#,0",
            "displayFolder": "ДДС"
          },
          {
            "name": "Сумма оплаты",
            "expression": [
              "",
              "CALCULATE ( ",
              "    SUM ( 'М002 Движения ДС'[Сумма Регл] ),",
              "    KEEPFILTERS (  '009 Документы движения'[Документ Тип] = \"Поступление безналичных денежных средств\" ),",
              "    KEEPFILTERS (  'М002 Движения ДС'[Тип ДС] = \"Безналичные\" ),",
              "    KEEPFILTERS (  '0091 Документы заказы клиентов'[Проведен] = \"Да\" )  ",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "ДДС"
          },
          {
            "name": "Задолженность",
            "expression": [
              "",
              "[Сумма заказа] - [Сумма оплаты]"
            ],
            "formatString": "#,0",
            "displayFolder": "ДДС"
          },
          {
            "name": "Отгрузить по заказу, ед.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ клиента, ед.],",
              "        'М001 Движения'[Вариант обеспечения] IN { \"Отгрузить\" }",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ клиента\\Ед."
          },
          {
            "name": "Обеспечивать обособленно, ед.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ клиента, ед.],",
              "        'М001 Движения'[Вариант обеспечения] IN { \"Обеспечивать обособленно\" }",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ клиента\\Ед."
          },
          {
            "name": "Отгрузить обособленно по заказу, ед.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ клиента, ед.],",
              "        'М001 Движения'[Вариант обеспечения] IN { \"Отгрузить обособленно\" }",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ клиента\\Ед."
          },
          {
            "name": "К обеспечению, ед.",
            "expression": [
              "",
              "VAR _result =",
              "    CALCULATE (",
              "        [Заказ клиента, ед.],",
              "        'М001 Движения'[Вариант обеспечения] IN { \"К обеспечению\" }",
              "    )",
              "RETURN",
              "    _result"
            ],
            "formatString": "#,0",
            "displayFolder": "Заказ клиента\\Ед."
          },
          {
            "name": "Поступления, ед.",
            "expression": [
              "VAR _result =",
              "    CALCULATE (",
              "        [Движения ед],",
              "        KEEPFILTERS('009 Документы движения'[Документ Тип]",
              "            IN {",
              "            \"Возврат товаров поставщику\",",
              "            \"Корректировка приобретения\",",
              "            \"Оприходование излишков товаров\",",
              "            \"Поступление от переработчика\",",
              "            \"Приобретение услуг и прочих активов\",",
              "            \"Приобретение товаров и услуг\"",
              "        })",
              "    )",
              "RETURN",
